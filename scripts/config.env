# environments
module add fwi/work
source /scinet/vast/etc/vastpreload-openmpi.bash
export UCX_VFS_ENABLE=n
export OMP_NUM_THREADS=1

# mpirun command
MPIRUN=mpirun

# measurement procs
NPROC_MEASURE=16

# SPECFEM solver path
SEM_PATH=~/software/specfem3d-cube2sph  # solver location

# platform
PLATFORM="slurm" # local/slurm/pbs 
USE_IO_TMPDIR=1  #use node-local temporary storage for IO when running on slurm/PBS
IO_TMPDIR=$SLURM_TMPDIR

# monitoring
MONITOR_MAX_RETRIES=3 # how many times to retry a failed monitor command before giving up
MONITOR_POLL_SECS=60 # how many seconds to wait between monitor polls

# JOB arrays (only for slurm and pbs, and run_fwi.sh)
NJOBS_PER_JOBARRAY=(1)

############## STOP HERE ###################

# export variables to environment variables
export PLATFORM  MONITOR_MAX_RETRIES  MONITOR_POLL_SECS 